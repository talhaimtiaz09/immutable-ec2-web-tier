# Copy to bootstrap.tfvars (gitignored) and apply once, locally, with admin
# credentials: terraform apply -var-file=bootstrap.tfvars

budget_alert_email = "you@example.com"
budget_limit_usd   = 10

# Set false if the account already has the token.actions.githubusercontent.com
# OIDC provider (check: aws iam list-open-id-connect-providers).
create_github_oidc_provider = true
